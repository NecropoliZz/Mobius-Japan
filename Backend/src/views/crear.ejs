<%- include("partials/head.ejs") %>
<%- include("partials/nav.ejs") %>
<main>
    <div class="formulario">
        <h2>Crear producto</h2>
            
        <form id="formularioProducto">
            <label for="nameProd">Nombre</label>
            <input type="text" name="nombre" id="nombreProd" required>

            <label for="imageProd">Imagen</label>
            <input type="text" name="imagen" id="imagenProd" required>

            <label for="categoryProd">Categoria</label>
            <select name="categoria" id="categoriaProd" required>
                <option value="figura">figura</option>
                <option value="juguete">juguete</option>
            </select>

            <label for="precioProd">Precio</label>
            <input type="number" name="precio" id="precioProd" required>
     
            <div id = "contenedor-btn">
                <input type="submit" value="Crear producto" class="btn">
            </div>
        </form>
    </div> 
    <div class="formulario">
        <h2>Alta Usuario</h2>
            
        <form id="formularioUsuario">
            <label for="nameProd">Nombre</label>
            <input type="text" name="nombreUsuario" id="nombreUser" required>

            <label for="imageProd">Email</label>
            <input type="text" name="emailUsuario" id="emailUser" required>

            <label for="imageProd">Password</label>
            <input type="text" name="passwordUsuario" id="passUser" required>
     
            <div id = "contenedor-btn">
                <input type="submit" value="Crear Usuario" class="btn">
            </div>
        </form>
    </div>  
</main>
<%- include("partials/footer.ejs") %>
<script src="/js/crear.js"></script>